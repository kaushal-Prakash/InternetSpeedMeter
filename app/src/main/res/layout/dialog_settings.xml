<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="16dp"/>

        <!-- Speed Unit Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/speed_unit"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rgSpeedUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbUnitBytes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/unit_bytes" />

            <RadioButton
                android:id="@+id/rbUnitBits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/unit_bits" />
        </RadioGroup>

        <!-- Refresh Rate Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_interval"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rgInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbInterval1s"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/interval_1s" />

            <RadioButton
                android:id="@+id/rbInterval2s"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/interval_2s" />

            <RadioButton
                android:id="@+id/rbInterval3s"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/interval_3s" />

            <RadioButton
                android:id="@+id/rbInterval5s"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/interval_5s" />
        </RadioGroup>

        <!-- Screen Off Behavior Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/screen_off_mode"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rgScreenOff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbScreenOffKeep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/screen_off_keep" />

            <RadioButton
                android:id="@+id/rbScreenOffSlow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/screen_off_slow" />

            <RadioButton
                android:id="@+id/rbScreenOffPause"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/screen_off_pause" />
        </RadioGroup>

        <!-- Status Bar Icon Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/show_icon_mode"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rgIconMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbIconNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/icon_mode_number" />

            <RadioButton
                android:id="@+id/rbIconApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/icon_mode_app" />
        </RadioGroup>

        <!-- Auto Start on Boot Switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/autostart_boot"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/autostart_boot_desc"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchAutostart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ok"
            style="@style/Widget.Material3.Button"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
